<UserControl x:Class="Rebound.Controls.BrickVisual"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Canvas>
        <Path x:Name="Shadow" Fill="#D0000000">
            <Path.Effect>
                <BlurEffect Radius="4" />
            </Path.Effect>
            <Path.CacheMode>
                <BitmapCache />
            </Path.CacheMode>
        </Path>
        <Path x:Name="Main">
            <Path.CacheMode>
                <BitmapCache />
            </Path.CacheMode>
        </Path>
    </Canvas>
</UserControl>
