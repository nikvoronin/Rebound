<UserControl x:Class="Rebound.Controls.BallVisual"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Canvas>
        <Ellipse x:Name="Shadow" Fill="#D0000000">
            <Ellipse.Effect>
                <BlurEffect Radius="4" />
            </Ellipse.Effect>
            <Ellipse.CacheMode>
                <BitmapCache />
            </Ellipse.CacheMode>
        </Ellipse>
        <Ellipse x:Name="Ball" Fill="#FFF8F8F2">
            <Ellipse.CacheMode>
                <BitmapCache />
            </Ellipse.CacheMode>
        </Ellipse>
        <Ellipse x:Name="Glare" Fill="Yellow">
            <Ellipse.CacheMode>
                <BitmapCache />
            </Ellipse.CacheMode>
        </Ellipse>
    </Canvas>
</UserControl>
