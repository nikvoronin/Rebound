<UserControl x:Class="Rebound.Controls.PaddleVisual"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Canvas>
        <Rectangle x:Name="Shadow"
                   RadiusX="8" RadiusY="8"
                   Fill="#D0000000">
            <Rectangle.Effect>
                <BlurEffect Radius="5" />
            </Rectangle.Effect>
            <Rectangle.CacheMode>
                <BitmapCache />
            </Rectangle.CacheMode>
        </Rectangle>
        <Rectangle x:Name="Bat"
                   RadiusX="8" RadiusY="8"
                   Fill="#FF8BE9FD"
                   Stroke="#FFF8F8F2"
                   StrokeThickness="1">
            <Rectangle.CacheMode>
                <BitmapCache />
            </Rectangle.CacheMode>
        </Rectangle>
    </Canvas>
</UserControl>
